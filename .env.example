# ==============================================================================
# PRPPAO APP HUB - Environment Variables
# ==============================================================================

# 1. URL ของ Google Apps Script (Web App)
# หากปล่อยว่างไว้ ระบบจะทำงานในโหมด Mock Data อัตโนมัติ เพื่อให้ทดสอบหน้าเว็บได้ทันที
GAS_API_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

# 2. รหัสผ่านสำหรับเข้าสู่ระบบ Admin เพื่อเพิ่ม/แก้ไข/ลบแอป
ADMIN_PASSWORD="admin1234"
